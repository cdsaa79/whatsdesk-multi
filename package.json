{
  "name": "whatsdesk-multi",
  "version": "1.0.1",
  "description": "Free-to-use multi-account WhatsApp Web desktop workspace with local CRM notes.",
  "author": "Dake",
  "main": "src/main.js",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-desktop",
    "whatsapp-business",
    "macos",
    "windows",
    "electron",
    "crm",
    "multi-account",
    "desktop-app",
    "source-available",
    "free-to-use",
    "no-resale"
  ],
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "package:mac": "electron-builder --mac --publish never",
    "package:win": "electron-builder --win --publish never",
    "package:all": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "co.dake.whatsdesk-multi",
    "productName": "WhatsDesk Multi",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "WhatsDesk Multi needs microphone access to support WhatsApp Web voice calls.",
        "NSCameraUsageDescription": "WhatsDesk Multi needs camera access to support WhatsApp Web video calls."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhatsDesk Multi"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
